# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
#APP_DEBUG=false

# 1. Настройка для интеграционных тестов (SQLite в памяти)
# :memory: — база создается в ОЗУ и исчезает после теста
#DATABASE_URL="sqlite:///:memory:"

# 2. Если нужны E2E тесты (PostgreSQL), эту строку можно
# закомментировать здесь и переопределить в .env.test.local
DATABASE_URL="postgresql://user:password@dplants_postgres:5432/db_name_test?serverVersion=15&charset=utf8"

# Настройки для почты и мессенджера (чтобы не спамить в реальности)
MESSENGER_TRANSPORT_DSN=test://
MAILER_DSN=null://
