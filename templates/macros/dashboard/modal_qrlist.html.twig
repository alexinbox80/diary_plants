{% macro modal_qrlist(items) %}
    <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true" style="top: -1.5rem;">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'dashboard.plant.registry.title'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body modal-margin">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 180px;">{{ 'dashboard.plant.registry.table.qr_codes_column_header'|trans }}</th>
                                    <th scope="col">{{ 'dashboard.plant.registry.table.plant_header'|trans }}</th>
                                    <th scope="col">{{ 'dashboard.plant.registry.table.room_header'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% if items is defined %}
                                {% for item in items %}
                                <tr>
                                    <td>
                                        <img src="{{ asset('uploads/' ~ item.img_qr_code_link) }}" alt="QR" class="img-thumbnail">
                                    </td>
                                    <td><strong>{{ item.title }}</strong></td>
                                    <td>{{ item.room }}</td>
                                </tr>
                                {% endfor %}
                            {% endif %}
                            </tbody>
                        </table>
                    </div>
                    <div class="pt-3">
                        <a type="button" class="btn btn-secondary" data-bs-dismiss="modal" href="#">{{ 'dashboard.plant.registry.table.button_pdf_label'|trans }}</a>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'dashboard.plant.registry.table.button_close_label'|trans }}</button>
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
