{% macro images(images, galleryId) %}
    {% import 'macros/dashboard/modal_carousel.html.twig' as modal_carousel %}

    {% set validImages = [] %}
    {% for image in images %}
        {% if image.mime_type is not null and image.path is defined and image.filename is defined %}
            {% set validImages = validImages|merge([image]) %}
        {% endif %}
    {% endfor %}

    <div class="position-relative" style="max-width: 200px;">
        {% if validImages is not empty %}
            <button
                class="btn btn-outline-secondary rounded-circle position-absolute top-50 start-0 translate-middle-y d-flex justify-content-center align-items-center"
                id="galleryPrev_{{ galleryId }}"
                style="margin-left: 8px; width: 24px; height: 24px; z-index: 10; box-shadow: 0 2px 5px rgba(0,0,0,.2); --bs-btn-padding-x: 0; --bs-btn-padding-y: 0;">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="position-relative overflow-hidden border rounded" style="height: 150px; width: 200px;">
                <img
                    src="{{ asset('uploads/' ~ validImages[0].path ~ validImages[0].filename) }}"
                    alt="{{ validImages[0].alt }}"
                    class="img-fluid w-100 h-100"
                    id="galleryImage_{{ galleryId }}"
                    data-current-index="0"
                    data-bs-toggle="modal"
                    data-bs-target="#PreviewModal{{ galleryId }}"
                    style="object-fit: cover; cursor: pointer;"
                >

                <div class="position-absolute top-0 start-0 m-2">
                    <span class="d-block rounded-circle"
                        id="statusIndicator_{{ galleryId }}"
                        style="width: 12px; height: 12px; background-color: {{ validImages[0].is_shown ? '#28a745' : '#dc3545' }};"
                        title="{{ (validImages[0].is_shown ? 'dashboard.modal.img_published' : 'dashboard.modal.img_unpublished')|trans }}">
                    </span>
                </div>
            </div>

            <button
                class="btn btn-outline-secondary rounded-circle position-absolute top-50 end-0 translate-middle-y d-flex justify-content-center align-items-center"
                id="galleryNext_{{ galleryId }}"
                style="margin-right: 8px; width: 24px; height: 24px; z-index: 10; box-shadow: 0 2px 5px rgba(0,0,0,.2); --bs-btn-padding-x: 0; --bs-btn-padding-y: 0;">
                <i class="fas fa-chevron-right"></i>
            </button>

            <a
                href="#"
                class="position-absolute bottom-0 start-0 m-2"
                id="editLink_{{ galleryId }}"
                title="{{ 'dashboard.modal.img_edit'|trans }}"
                style="z-index: 10;">
                <i class="fas fa-edit text-white bg-dark bg-opacity-50 rounded p-1" style="width: 100%"></i>
            </a>

            <div class="text-white small position-absolute bottom-0 end-0 m-2">
                <span id="galleryCounter_{{ galleryId }}">1 / {{ validImages|length }}</span>
            </div>
        {% endif %}
    </div>

    {% if validImages is not empty %}
        {{ modal_carousel.modal_carousel(galleryId, validImages) }}
    {% endif %}

    <script type="module">
        import ImageGallery from "{{ asset('assets/js/dashboard/carousel/ImageGallery.js') }}";

        document.addEventListener('DOMContentLoaded', function () {
            const validImages = {{ validImages|json_encode|raw }};
            new ImageGallery('{{ galleryId }}', validImages);
        });
    </script>
{% endmacro %}
