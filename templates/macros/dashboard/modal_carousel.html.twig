{% macro modal_carousel(id, images) %}
    <div class="modal fade" id="PreviewModal{{ id }}" tabindex="-1" aria-labelledby="PreviewImageModalLabel{{ id }}">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
            <div class="modal-content" style="min-height: 70vh;">
                <div class="modal-header">
                    <h5 class="modal-title" id="PreviewImageModalLabel{{ id }}">Предпросмотр изображений</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body p-0 d-flex align-items-center justify-content-center" style="min-height: 70vh">
                    <div class="position-absolute top-50 start-0 translate-middle-y d-flex justify-content-center align-items-center" style="z-index: 11; margin-left: 16px;">
                        <button
                            class="btn btn-outline-secondary rounded-circle d-flex justify-content-center align-items-center"
                            id="carouselPrev_{{ id }}"
                            style="width: 36px; height: 36px; box-shadow: 0 2px 8px rgba(0,0,0,.3); --bs-btn-padding-x: 0; --bs-btn-padding-y: 0;">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                    </div>
                    <div class="position-absolute top-50 end-0 translate-middle-y d-flex justify-content-center align-items-center" style="z-index: 11; margin-right: 16px;">
                        <button
                            class="btn btn-outline-secondary rounded-circle d-flex justify-content-center align-items-center"
                            id="carouselNext_{{ id }}"
                            style="width: 36px; height: 36px; box-shadow: 0 2px 8px rgba(0,0,0,.3); --bs-btn-padding-x: 0; --bs-btn-padding-y: 0;">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="position-relative d-flex align-items-center justify-content-center mh-100 mw-100" style="max-height: 700px">
                        {% if images is not empty %}
                            <div class="position-relative overflow-hidden border rounded" style="">
                                <img
                                    src="{{ asset('uploads/' ~ images[0].path ~ images[0].filename) }}"
                                    alt="{{ images[0].alt }}"
                                    class="img-fluid"
                                    id="carouselImage_{{ id }}"
                                    data-current-index="{{ id }}"
                                    style="object-fit: contain;"
                                >
                                <div class="position-absolute top-0 start-0 w-100 p-3" style="pointer-events: none;">
                                    <div class="text-white bg-dark bg-opacity-50 rounded p-2">
                                        <h5 id="carouselTitle_{{ id }}" class="mb-1">{{ images[0].title }}</h5>
                                        <p id="carouselDescription_{{ id }}" class="mb-0 small">{{ images[0].description }}</p>
                                    </div>
                                </div>
                                <div class="position-absolute top-0 start-0 m-2">
                                    <span class="d-block rounded-circle"
                                          id="carouselStatusIndicator_{{ id }}"
                                          style="width: 12px; height: 12px; background-color: {{ images[0].is_shown ? '#28a745' : '#dc3545' }};"
                                          title="{{ images[0].is_shown ? 'Опубликовано' : 'Черновик' }}">
                                    </span>
                                </div>
                            </div>
                            <a
                                href="#"
                                class="position-absolute bottom-0 start-0 m-2"
                                id="carouselEditLink_{{ id }}"
                                title="Редактировать"
                                style="z-index: 10;">
                                <i class="fas fa-edit text-white bg-dark bg-opacity-50 rounded p-1" style="width: 100%"></i>
                            </a>
                            <div class="text-muted small position-absolute bottom-0 end-0 m-3">
                                <span id="carouselCounter_{{ id }}" class="text-white bg-dark bg-opacity-50 rounded p-1">1 / {{ images|length }}</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                </div>
            </div>
        </div>
    </div>

    <script type="module">
        import ModalCarousel from "{{ asset('assets/js/dashboard/carousel/ModalCarousel.js') }}";

        document.addEventListener('DOMContentLoaded', function () {
            const validImages = {{ images|json_encode|raw }};
            new ModalCarousel('{{ id }}', validImages);
        });
    </script>
{% endmacro %}
