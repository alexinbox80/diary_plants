{% macro tab_content(type, diaries, markers) %}
    {% import 'macros/dashboard/diary/marker.html.twig' as marker_header %}
    {% import 'macros/dashboard/diary/table.html.twig' as diary_grid %}

    <div class="tab-pane fade {{ type is same as 'watering' ? 'show active' : '' }} p-0" id="{{ type }}" role="tabpanel">
        Содержимое {{ type }} вкладки...
        <div class="d-flex">
            {{ marker_header.marker(-1, type, 'X', 'Удалить статус', '#E3D2EA') }}
            {% for key, marker in markers %}
                {{ marker_header.marker(key, type, marker.letter, marker.description, marker.color, marker.id) }}
            {% endfor %}
        </div>
        <div class="table-responsive border-top mt-3">
            {{ diary_grid.table(diaries, type) }}
        </div>
    </div>
{% endmacro %}
