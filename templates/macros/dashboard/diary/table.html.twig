{% macro table(diaries, type) %}
    {% import 'macros/dashboard/diary/day_class.html.twig' as class %}
    {% import 'macros/dashboard/diary/current_day_class.html.twig' as current_class %}
    {% import 'macros/dashboard/diary/cell_id.html.twig' as cell_id %}

    {% set current_day = diaries.table_header.currentDay %}
    {% set month = diaries.table_title.month %}
    {% set year = diaries.table_title.year %}

    <table class="table table-striped table-bordered border-black">
        <thead>
            <th class="thead-tr-th align-middle text-center table-bordered border-black col-width">
                <span>#</span>
            </th>
            <th class="thead-tr-th align-middle text-center table-bordered border-black">
                <span>Растение</span>
            </th>
        {% for key, day in diaries.table_header['tableHeader'] %}
            <th class="thead-tr-th align-middle text-center table-bordered border-black col-width
                            {{ class.day_class(day.name_day) }}
                            {{ (month == 'now'|date('n') and year == 'now'|date('Y')) ? current_class.current_day_class(current_day, day.num_day) : '' }}"
                            {%- if month == 'now'|date('n') and year == 'now'|date('Y') and year == 'now'|date('Y') and current_day|number_format == day.num_day|number_format -%}
                                title="сегодня"
                            {%- endif -%}>
                {{ day.num_day }} <br> {{ day.name_day }}
            </th>
        {% endfor %}
        </thead>
        <tbody>
        {% for key, plant in diaries.table_body['tableBody'] %}
            <tr>
                <td class="align-middle text-center col-height" title="{{ plant.id }}">
                    {{ key + 1 }}
                </td>
                <td class="align-middle text-center">
                    <a class="plant-link" href={{ path('dashboard.plants.profile', {'uuid': plant.oid}) }}>
                        {{ plant.title }}
                    </a>
                </td>
                {% for key, day in diaries.table_header['tableHeader'] %}
                    <td
                        id="{{ cell_id.get_cell_id(type, plant.id, day.num_day) }}"
                        class="align-middle text-center
                                    {{ class.day_class(day.name_day) }}
                                    {{ (month == 'now'|date('n') and year == 'now'|date('Y')) ? current_class.current_day_class(current_day, day.num_day) : '' }}">
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endmacro %}
