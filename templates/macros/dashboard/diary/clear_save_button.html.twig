{% macro clear_save(position) %}
    <div class="d-flex justify-content-end">
        <div class="button">
            <span id="clear__schedule-{{ position }}" class="btn btn-light me-2 clear__schedule">Очистить</span>
            <span id="save__schedule-{{ position }}" class="btn btn-success save__schedule">Сохранить</span>
        </div>
    </div>
{% endmacro %}
