{% macro tab_button(type) %}
    {% set tabs = {
        'watering': 'Полив',
        'pest': 'Вредители',
        'stimulant': 'Стимуляторы',
        'fertilizer': 'Удобрения'
    } %}

    <li class="nav-item" role="presentation">
        <button class="nav-link {{ type is same as 'watering' ? 'active' : '' }}" id="{{ type }}-tab" data-bs-toggle="tab" data-bs-target="#{{ type }}" type="button" role="tab">{{ tabs[type] }}</button>
    </li>
{% endmacro %}
