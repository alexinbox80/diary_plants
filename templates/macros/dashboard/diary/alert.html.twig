<div id="dynamic-alert-container" class="position-absolute top-50 start-50 translate-middle z-3 d-none">
    <div id="alert-window" class="alert alert-warning alert-dismissible fade show d-flex flex-column" role="alert">
        <div class="alert-header">
            {# Важно: используем d-none вместо удаления, чтобы просто скрыть #}
            <button type="button" class="btn-close" onclick="document.getElementById('dynamic-alert-container').classList.add('d-none')" aria-label="Close"></button>
        </div>
        <div class="alert-content d-flex align-items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" class="bi bi-exclamation-triangle-fill flex-shrink-0 me-3" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <span id="dynamic-alert-message"></span>
        </div>
    </div>
</div>
