{% macro select_month(position, url_prev, url_next) %}
    <div class="d-flex justify-content-between mt-3 mb-3">
        <div class="button">
            <a id="prev__month-{{ position }}" class="btn btn-light me-1 px-2 py-1" href="{{ url_prev }}" title="Предыдущий месяц">
                <i class="fa fa-chevron-left"></i>
            </a>
        </div>
        <div class="button">
            <a id="next__month-{{ position }}" class="btn btn-light me-1 px-2 py-1" href="{{ url_next }}" title="Последующий месяц">
                <i class="fa fa-chevron-right"></i>
            </a>
        </div>
    </div>
{% endmacro %}
