{% macro modal_image(id, title, alt, src, single) %}
    <div class="modal fade modal-width" id="PreviewModalIm{{ id }}" tabindex="-1" aria-labelledby="PreviewImageModalLabel{{ id }}" aria-modal="true" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content modal-dialog-centered">
                <div class="modal-header">
                    <h5 class="modal-title" id="PreviewImageModalLabel{{ id }}">{{ title }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                {% if single == 'single' %}
                    <div class="modal-body">
                        <!-- Здесь ваш контент для картинки -->
                        <img src="{{ asset(src) }}" alt="{{ alt }}" class="img-fluid">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endmacro %}
