{% macro image(image) %}
    <div class="position-relative overflow-hidden rounded-top">
        <a href="{{ asset('uploads/' ~ image.img_tag) }}"
           class="d-block gallery-link"
           data-caption="{{ image.description }}"
           target="_blank">
            <img src="{{ asset('uploads/' ~ image.img_tag) }}"
                 class="card-img-top transition-all"
                 alt="{{ image.alt }}"
                 style="height: 160px; object-fit: cover;">

            <div class="gallery-overlay d-flex align-items-center justify-content-center">
                <i class="fas fa-magnifying-glass text-white fs-4"></i>
            </div>

            <a
                href="{{ path('dashboard.images.edit', {id: image.id}) }}"
                class="position-absolute bottom-0 start-0 m-2"
                id="editLink_{{ image.id }}"
                title="Редактировать"
                style="z-index: 10;">
                <i class="fas fa-edit text-white bg-dark bg-opacity-50 rounded p-1" style="width: 100%"></i>
            </a>
        </a>
    </div>
{% endmacro %}
