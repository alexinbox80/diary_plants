{% macro plant_gallery(plants) %}
    {% import 'macros/dashboard/profile/is_published_tag.html.twig' as is_published %}
    {% import 'macros/dashboard/profile/image.html.twig' as img %}
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
        {% for image in plants %}
            <div class="col">
                <!-- Класс gallery-item для эффекта приподнимания -->
                <div class="card h-100 shadow-sm border-0 gallery-item overflow-hidden">
                    {{ img.image(image) }}

                    <div class="card-body p-2 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-light text-dark border" style="font-size: 0.65rem;">
                                <i class="bi bi-camera me-1"></i>{{ image.file_date }}
                            </span>

                            {{ is_published.tag(image.is_shown) }}
                        </div>

                        {% if image.description %}
                            <p class="card-text text-truncate small text-muted mb-0"
                               title="{{ image.description }}"
                               style="font-size: 0.75rem;">
                                {{ image.description }}
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
