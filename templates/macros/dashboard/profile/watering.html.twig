{% macro watering(waterins) %}
    <div class="d-flex flex-wrap gap-2">
        {% for key, label in waterins %}
            <div class="border rounded p-2 {{ loop.last ? 'border-primary bg-primary-subtle' : 'bg-white' }}">
                <small class="d-block text-muted" style="font-size: 0.7rem;">
                    {{ loop.last ? 'След.' : 'Дата' }}
                </small>
                <span class="{{ loop.last ? 'fw-bold' : '' }}">{{ label.use_date }}</span>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
