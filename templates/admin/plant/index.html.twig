{% extends 'layout/admin.html.twig' %}

{% block header %}
    {% include 'components/admin/navbar.html.twig' with {'title': 'Растения'} %}
{% endblock %}

{% block body %}
    <div class="container-fluid page-body-wrapper">
        {% include 'components/admin/sidebar.html.twig' %}
        <div class="main-panel">
            <div class="content-wrapper">
                {% if pagination is defined %}
                    {% include 'components/admin/table.html.twig' with
                        {
                            'title': 'Список растений',
                            'array': plants,
                            'pagination': pagination,
                            'route_index': 'admin.plants.index',
                            'route_pagination': 'admin.plants_paginated.index'
                        }
                    %}
                {% else %}
                    {% include 'components/admin/table.html.twig' with
                        {
                            'title': 'Список растений',
                            'array': plants,
                            'route_index': 'admin.plants.index',
                            'route_pagination': 'admin.plants_paginated.index'
                        }
                    %}
                {% endif %}
            </div>
            <!-- content-wrapper ends -->
            {% include 'components/admin/footer.html.twig' %}
        </div>
        <!-- main-panel ends -->
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" defer src="{{ asset('assets/js/admin/table/main.js') }}" ></script>
{% endblock %}
