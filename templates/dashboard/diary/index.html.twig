{% import 'macros/dashboard/diary/human_month.html.twig' as month %}
{% import 'macros/dashboard/diary/select_month.html.twig' as select %}
{% import 'macros/dashboard/diary/clear_save_button.html.twig' as button %}
{% import 'macros/dashboard/diary/month_navigation_url_prev.html.twig' as navigation_prev %}
{% import 'macros/dashboard/diary/month_navigation_url_next.html.twig' as navigation_next %}

{% extends 'layout/dashboard.html.twig' %}

{% block header %}
    {% include 'components/dashboard/navbar.html.twig' with {'title': 'Ежедневник'} %}
{% endblock %}

{% block body %}
    <div class="container-fluid page-body-wrapper">
        {% include 'components/dashboard/sidebar.html.twig' %}
        <div class="main-panel">
            <div class="content-wrapper">
                {% if diaries is defined %}
                    {% set title = {
                        'month': diaries.table_title.month,
                        'year': diaries.table_title.year
                    } %}

                    {% set prev = navigation_prev.month_navigation_url_prev(diaries.table_title.year, diaries.table_title.month) %}
                    {% set next = navigation_next.month_navigation_url_next(diaries.table_title.year, diaries.table_title.month) %}

                    <div class="row">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <h4 class="mb-sm-0"> {{ month.human_month(title.month) }} {{ title.year }} года </h4>
                                    </div>
                                    {{ button.clear_save('top') }}
                                </div>

                                {% include 'macros/dashboard/diary/alert.html.twig' %}
                                {{ select.select_month('top', prev, next) }}
                                <div class="col-md-12 px-0">
                                    {% include 'components/dashboard/tabs.html.twig' with { 'diaries': diaries } %}
                                </div>
                                {{ select.select_month('bottom', prev, next) }}
                                <div class="d-flex justify-content-end">
                                    {{ button.clear_save('bottom') }}
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="d-flex mt-4 flex-wrap align-items-center">
                        <p class="text-muted mb-sm-0">Нет данных</p>
                    </div>
                {% endif %}
            </div>
            <!-- content-wrapper ends -->
            {% include 'components/dashboard/footer.html.twig' %}
        </div>
        <!-- main-panel ends -->
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" defer src="{{ asset('assets/js/dashboard/diary/main.js') }}"></script>
{% endblock %}
