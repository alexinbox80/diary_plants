{% extends 'layout/dashboard.html.twig' %}

{% block header %}
    {% include 'components/dashboard/navbar.html.twig' with {'title': 'Ежедневник'} %}
{% endblock %}

{% block body %}
    <div class="container-fluid page-body-wrapper">
        {% include 'components/dashboard/sidebar.html.twig' %}
        <div class="main-panel">
            <div class="content-wrapper">
                {% if diaries is defined %}
                    <div class="row">
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-end">
                                    <div class="button">
                                        <span id="clear__schedule-top" class="btn btn-light me-2">Очистить</span>
                                        <span id="save__schedule-top" class="btn btn-success me-2">Сохранить</span>
                                    </div>
                                </div>
                                <div class="col-md-12 px-0">
                                    {% include 'components/dashboard/tabs.html.twig' with { 'diaries': diaries } %}
                                </div>
                                <div class="d-flex justify-content-end mt-4">
                                    <div class="button">
                                        <span id="clear__schedule-bottom" class="btn btn-light me-2">Очистить</span>
                                        <span id="save__schedule-bottom" class="btn btn-success me-2">Сохранить</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="d-flex mt-4 flex-wrap align-items-center">
                        <p class="text-muted mb-sm-0">Нет данных</p>
                    </div>
                {% endif %}
            </div>
            <!-- content-wrapper ends -->
            {% include 'components/dashboard/footer.html.twig' %}
        </div>
        <!-- main-panel ends -->
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
