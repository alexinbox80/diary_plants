{% extends 'layout/dashboard.html.twig' %}

{% block header %}
    {% include 'components/dashboard/navbar.html.twig' with {'title': 'Стимуляторы'} %}
{% endblock %}

{% block body %}
    <div class="container-fluid page-body-wrapper">
        {% include 'components/dashboard/sidebar.html.twig' %}
        <div class="main-panel">
            <div class="content-wrapper">
                {% if pagination is defined %}
                    {% include 'components/dashboard/table.html.twig' with
                        {
                            'title': 'Список стимуляторов',
                            'array': stimulants,
                            'pagination': pagination,
                            'route_index': 'dashboard.stimulants.index',
                            'route_pagination': 'dashboard.stimulants_paginated.index',
                            'route_edit': 'dashboard.stimulants.edit',
                            'route_create': 'dashboard.stimulants.create',
                            'route_delete': 'dashboard.stimulants.delete'
                        }
                    %}
                {% else %}
                    {% include 'components/dashboard/table.html.twig' with
                        {
                            'title': 'Список стимуляторов',
                            'array': stimulants,
                            'route_index': 'dashboard.stimulants.index',
                            'route_pagination': 'dashboard.stimulants_paginated.index',
                            'route_edit': 'dashboard.stimulants.edit',
                            'route_create': 'dashboard.stimulants.create',
                            'route_delete': 'dashboard.stimulants.delete'
                        }
                    %}
                {% endif %}
            </div>
            <!-- content-wrapper ends -->
            {% include 'components/dashboard/footer.html.twig' %}
        </div>
        <!-- main-panel ends -->
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" defer src="{{ asset('assets/js/dashboard/table/main.js') }}" data-entity="stimulator"></script>
{% endblock %}
