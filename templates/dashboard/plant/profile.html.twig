{% import 'macros/dashboard/image.html.twig' as image_tag %}
{% import 'macros/dashboard/profile/plant_gallery.html.twig' as plant_gal %}
{% import 'macros/dashboard/profile/offspring_gallery.html.twig' as offspring_gal %}
{% import 'macros/dashboard/profile/watering.html.twig' as water %}
{% import 'macros/dashboard/profile/usage.html.twig' as us %}
{% import 'macros/dashboard/profile/repotting.html.twig' as repot %}

{% extends 'layout/dashboard.html.twig' %}

{% block header %}
    {% include 'components/dashboard/navbar.html.twig' with {'title': 'Профиль растения'} %}
{% endblock %}

{% block body %}
    <div class="container-fluid page-body-wrapper">
        <div class="main-panel w-100">
            <div class="content-wrapper">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white d-flex justify-content-between">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-light text-dark me-4">ID: {{ plant.profile_body.id }}</span>
                            <h5 class="mb-0">Растение: {{ plant.profile_body.title }}</h5>
                        </div>

                        <button type="button"
                                class="btn-close btn-close-white"
                                aria-label="Close"
                                onclick="history.back()"
                                title="Назад">
                        </button>
                    </div>
                    <div class="card-body profile-scroll-container">
                        {% for key, label in plant.profile_header %}
                            <div class="profile-row">
                                <div class="profile-label">
                                    {{ label }}
                                </div>
                                <div class="profile-value">
                                    {% set value = plant.profile_body[key] %}

                                    {% if key == 'img_qr_code_link' and value %}
                                        {{ image_tag.image(plant.profile_body.id, 'table-image-thumb', 'QR код', 'QR', value, 'single') }}
                                    {% elseif key == 'oid' %}
                                        <code class="small text-muted">{{ value }}</code>

                                    {% elseif key == 'is_shown' or key == 'is_sold' %}
                                        <span class="badge {{ value == 'Да' ? 'bg-success' : 'bg-secondary' }}">
                                            {{ value }}
                                        </span>

                                    {% elseif value is null or value == "" or value is empty %}
                                        <span class="text-muted small"><em>не указано</em></span>

                                    {% elseif key == 'img_gallery' %}
                                        {{ plant_gal.plant_gallery(value) }}

                                    {% elseif key == 'usage_watering' %}
                                       {{ water.watering(value) }}

                                    {% elseif key == 'usage_stimulant' %}
                                        {{ us.usage(value) }}

                                    {% elseif key == 'usage_pest' %}
                                        {{ us.usage(value) }}

                                    {% elseif key == 'usage_fertilizer' %}
                                        {{ us.usage(value) }}

                                    {% elseif key == 'repottings' %}
                                        {{ repot.repotting(value) }}

                                    {% elseif key == 'offsprings' %}
                                        {{ offspring_gal.offspring_gallery(value) }}

                                    {% else %}
                                        {{ value }}
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                onclick="history.back()">
                            Закрыть
                        </button>
                        <small class="text-muted">Обновлено: {{ plant.profile_body.updated_at }}</small>
                    </div>
                </div>
            </div>
            <!-- content-wrapper ends -->
            {% include 'components/dashboard/footer.html.twig' %}
        </div>
        <!-- main-panel ends -->
    </div>
{% endblock %}
