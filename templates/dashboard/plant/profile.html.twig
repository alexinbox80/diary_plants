{% import 'macros/dashboard/image.html.twig' as image_tag %}

{% extends 'layout/dashboard.html.twig' %}

{% block header %}
    {% include 'components/dashboard/navbar.html.twig' with {'title': 'Профиль растения'} %}
{% endblock %}

{% block body %}
    <div class="container-fluid page-body-wrapper">
        <div class="main-panel w-100">
            <div class="content-wrapper">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white d-flex justify-content-between">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-light text-dark me-4">ID: {{ plant.profile_body.id }}</span>
                            <h5 class="mb-0">Растение: {{ plant.profile_body.title }}</h5>
                        </div>

                        <button type="button"
                                class="btn-close btn-close-white"
                                aria-label="Close"
                                onclick="history.back()"
                                title="Назад">
                        </button>
                    </div>
                    <div class="card-body profile-scroll-container">
                        {% for key, label in plant.profile_header %}
                            <div class="profile-row">
                                <div class="profile-label">
                                    {{ label }}
                                </div>
                                <div class="profile-value">
                                    {% set value = plant.profile_body[key] %}

                                    {% if key == 'img_qr_code_link' and value %}
                                        {{ image_tag.image(plant.profile_body.id, 'table-image-thumb', 'QR код', 'QR', value, 'single') }}
                                    {% elseif key == 'oid' %}
                                        <code class="small text-muted">{{ value }}</code>

                                    {% elseif key == 'is_shown' or key == 'is_sold' %}
                                        <span class="badge {{ value == 'Да' ? 'bg-success' : 'bg-secondary' }}">
                                                {{ value }}
                                            </span>

                                    {% elseif value is null or value == "" or value is empty %}
                                        <span class="text-muted small"><em>не указано</em></span>

                                    {% elseif key == 'img_gallery' %}
                                        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                                            {% for image in value %}
                                                <div class="col">
                                                    <!-- Класс gallery-item для эффекта приподнимания -->
                                                    <div class="card h-100 shadow-sm border-0 gallery-item overflow-hidden">

                                                        <div class="position-relative overflow-hidden">
                                                            {# Ссылка и эффект увеличения картинки #}
                                                            <a href="{{ asset('uploads/' ~ image.img_tag) }}" class="gallery-link overflow-hidden rounded-top" target="_blank">
                                                                <img src="{{ asset('uploads/' ~ image.img_tag) }}"
                                                                     class="card-img p-0 transition-all"
                                                                     alt="{{ image.alt }}"
                                                                     style="height: 160px; object-fit: cover;">

                                                                {# Оверлей с иконкой лупы #}
                                                                <div class="gallery-overlay d-flex align-items-center justify-content-center">
                                                                    <i class="bi bi-zoom-in text-white fs-4"></i>
                                                                </div>
                                                            </a>
                                                        </div>

                                                        <div class="card-body p-2 bg-white">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge bg-light text-dark border" style="font-size: 0.65rem;">
                            <i class="bi bi-camera me-1"></i>{{ image.file_date }}
                        </span>
                                                                {% if image.is_shown %}
                                                                    <span class="badge bg-success rounded-circle d-inline-block shadow-sm"
                                                                          style="width: 8px; height: 8px; padding: 0;"
                                                                          title="Опубликовано"></span>
                                                                {% endif %}
                                                            </div>

                                                            {% if image.description %}
                                                                <p class="card-text text-truncate small text-muted mb-0"
                                                                   title="{{ image.description }}"
                                                                   style="font-size: 0.75rem;">
                                                                    {{ image.description }}
                                                                </p>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>


                                    {% elseif key == 'usage_watering' %}
                                        <div class="d-flex flex-wrap gap-2">
                                            {% for key, label in value %}
                                                <div class="border rounded p-2 {{ loop.last ? 'border-primary bg-primary-subtle' : 'bg-white' }}">
                                                    <small class="d-block text-muted" style="font-size: 0.7rem;">
                                                        {{ loop.last ? 'След.' : 'Дата' }}
                                                    </small>
                                                    <span class="{{ loop.last ? 'fw-bold' : '' }}">{{ label.use_date }}</span>
                                                </div>
                                            {% endfor %}
                                        </div>

                                    {% elseif key == 'usage_stimulant' %}
                                        <div class="d-flex flex-wrap gap-2">
                                            {% for key, label in value %}
                                                <div class="border rounded p-2 bg-white">
                                                    <small class="d-block text-muted" style="font-size: 0.7rem;">Дата</small>
                                                    <span>{{ label.use_date }}</span>
                                                </div>
                                            {% endfor %}
                                        </div>

                                    {% elseif key == 'usage_pest' %}
                                        <div class="d-flex flex-wrap gap-2">
                                            {% for key, label in value %}
                                                <div class="border rounded p-2 bg-white">
                                                    <small class="d-block text-muted" style="font-size: 0.7rem;">Дата</small>
                                                    <span>{{ label.use_date }}</span>
                                                </div>
                                            {% endfor %}
                                        </div>

                                    {% elseif key == 'usage_fertilizer' %}
                                        <div class="d-flex flex-wrap gap-2">
                                            {% for key, label in value %}
                                                <div class="border rounded p-2 bg-white">
                                                    <small class="d-block text-muted" style="font-size: 0.7rem;">Дата</small>
                                                    <span>{{ label.use_date }}</span>
                                                </div>
                                            {% endfor %}
                                        </div>

                                    {% elseif key == 'repottings' %}
                                        <div class="d-flex flex-column gap-3">
                                            {% for label in value %}
                                                <div class="card shadow-sm border-0 overflow-hidden">
                                                    <div class="row g-0 align-items-center">
                                                        <!-- Дата и тип -->
                                                        <div class="col-md-2 bg-success bg-opacity-10 text-center py-3 border-end">
                                                            <div class="fw-bold text-success" style="font-size: 1.1rem;">{{ label.repotted_at }}</div>
                                                            <span class="badge bg-success mt-1">{{ label.type }}</span>
                                                        </div>

                                                        <!-- Основные параметры -->
                                                        <div class="col-md-4 px-4 py-2">
                                                            <div class="d-flex align-items-center">
                                                                <i class="bi bi-box-seam fs-4 text-secondary me-3"></i>
                                                                <div>
                                                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Горшок</small>
                                                                    <span class="fw-bold">{{ label.pot_material }}</span>
                                                                    <span class="text-muted ms-1">({{ label.pot_size }} см)</span>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Комментарий -->
                                                        <div class="col-md-4 px-4 py-2 border-start-md">
                                                            <small class="text-muted d-block text-uppercase" style="font-size: 0.7rem;">Комментарий</small>
                                                            <div class="small fst-italic text-truncate" title="{{ label.comment }}">
                                                                {% if label.comment %}
                                                                    <i class="bi bi-chat-left-dots me-1 opacity-50"></i>{{ label.comment }}
                                                                {% else %}
                                                                    <span class="text-muted">Нет заметок</span>
                                                                {% endif %}
                                                            </div>
                                                        </div>

                                                        <!-- Мета-информация -->
                                                        <div class="col-md-2 text-end pe-3 py-2">
                                                            <small class="text-muted" style="font-size: 0.65rem; display: block;">
                                                                ID: {{ label.id }}
                                                            </small>
                                                            <small class="text-muted" style="font-size: 0.65rem;">
                                                                {{ label.updated_at|date('d.m.y') }}
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% elseif key == 'offsprings' %}
                                        {% for offspring in value %}
                                            <div class="offspring-group mb-4">
                                                <h5>Плод (ID: {{ offspring.id }})</h5>

                                                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                                                    {# Второй цикл: перебираем картинки конкретного объекта #}
                                                    {% for image in offspring.img_gallery %}
                                                        <div class="col">
                                                            <div class="card h-100 shadow-sm border-0 gallery-item">
                                                                <div class="position-relative overflow-hidden rounded-top">
                                                                    {# Ссылка для открытия картинки #}
                                                                    <a href="{{ asset('uploads/' ~ image.img_tag) }}"
                                                                       class="d-block gallery-link"
                                                                       data-caption="{{ image.description }}"
                                                                       target="_blank">
                                                                        <img src="{{ asset('uploads/' ~ image.img_tag) }}"
                                                                             class="card-img-top transition-all"
                                                                             alt="{{ image.alt }}"
                                                                             style="height: 160px; object-fit: cover;">

                                                                        {# Иконка лупы при наведении #}
                                                                        <div class="gallery-overlay d-flex align-items-center justify-content-center">
                                                                            <i class="bi bi-zoom-in text-white fs-4"></i>
                                                                        </div>
                                                                    </a>
                                                                </div>

                                                                <div class="card-body p-2 bg-white">
                                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                                    <span class="badge bg-light text-dark border" style="font-size: 0.65rem;">
                                                                        <i class="bi bi-calendar-event me-1"></i>{{ image.file_date }}
                                                                    </span>
                                                                        {% if image.is_shown %}
                                                                            <span class="badge bg-success rounded-circle d-inline-block shadow-sm"
                                                                                  style="width: 10px; height: 10px; padding: 0; vertical-align: middle;"
                                                                                  title="Опубликовано">
                                                                    </span>
                                                                        {% endif %}
                                                                    </div>

                                                                    <div class="card-body p-3 bg-white">
                                                                        <!-- Даты: Цветение и Плодоношение -->
                                                                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                                                                            <div class="text-center">
                                                                                <small class="text-muted d-block" style="font-size: 0.65rem;">Цветение</small>
                                                                                <span class="badge bg-info-subtle text-info small">{{ offspring.flowering_date }}</span>
                                                                            </div>
                                                                            <div class="text-center border-start ps-3">
                                                                                <small class="text-muted d-block" style="font-size: 0.65rem;">Урожай</small>
                                                                                <span class="badge bg-warning-subtle text-warning-emphasis small">{{ offspring.fruiting_date }}</span>
                                                                            </div>
                                                                        </div>

                                                                        <!-- Характеристики плода -->
                                                                        <div class="row g-2 mb-2">
                                                                            <div class="col-6">
                                                                                <div class="d-flex align-items-center small">
                                                                                    <i class="bi bi-pnum-1-circle me-2 text-secondary"></i>
                                                                                    <span>{{ offspring.quantity }} шт.</span>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-6">
                                                                                <div class="d-flex align-items-center small">
                                                                                    <i class="bi bi-speedometer2 me-2 text-secondary"></i>
                                                                                    <span>{{ offspring.mass }} г</span>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-12">
                                                                                <div class="d-flex align-items-center small">
                                                                                    <i class="bi bi-palette me-2 text-secondary"></i>
                                                                                    <span>{{ offspring.color }}</span>
                                                                                </div>
                                                                            </div>
                                                                        </div>

                                                                        <!-- Вкус и Комментарий -->
                                                                        <div class="bg-light rounded p-2 mb-1">
                                                                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.6rem;">Вкус:</small>
                                                                            <p class="small mb-1 text-dark">{{ offspring.flavor }}</p>

                                                                            {% if value[0].comment %}
                                                                                <hr class="my-1 opacity-25">
                                                                                <small class="text-danger-emphasis small fst-italic">
                                                                                    <i class="bi bi-sticky me-1"></i>{{ offspring.comment }}
                                                                                </small>
                                                                            {% endif %}
                                                                        </div>
                                                                    </div>

                                                                    {% if image.description %}
                                                                        <p class="card-text text-truncate small text-muted mb-0" title="{{ image.description }}">
                                                                            {{ image.description }}
                                                                        </p>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        {{ value }}
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                onclick="history.back()">
                            Закрыть
                        </button>
                        <small class="text-muted">Обновлено: {{ plant.profile_body.updated_at }}</small>
                    </div>
                </div>
            </div>
            <!-- content-wrapper ends -->
            {% include 'components/dashboard/footer.html.twig' %}
        </div>
        <!-- main-panel ends -->
    </div>
{% endblock %}
