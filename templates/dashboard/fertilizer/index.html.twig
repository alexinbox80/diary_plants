{% extends 'layout/dashboard.html.twig' %}

{% block header %}
    {% include 'components/dashboard/navbar.html.twig' with { 'title': 'dashboard.fertilizer.title'|trans } %}
{% endblock %}

{% block body %}
    <div class="container-fluid page-body-wrapper">
        {% include 'components/dashboard/sidebar.html.twig' %}
        <div class="main-panel">
            <div class="content-wrapper">
                {% if pagination is defined %}
                    {% include 'components/dashboard/table.html.twig' with
                        {
                            'title': 'dashboard.fertilizer.list'|trans,
                            'array': fertilizers,
                            'pagination': pagination,
                            'route_index': 'dashboard.fertilizers.index',
                            'route_pagination': 'dashboard.fertilizers_paginated.index',
                            'route_edit': 'dashboard.fertilizers.edit',
                            'route_create': 'dashboard.fertilizers.create',
                            'route_delete': 'dashboard.fertilizers.delete'
                        }
                    %}
                {% else %}
                    {% include 'components/dashboard/table.html.twig' with
                        {
                            'title': 'dashboard.fertilizer.list'|trans,
                            'array': fertilizers,
                            'route_index': 'dashboard.fertilizers.index',
                            'route_pagination': 'dashboard.fertilizers_paginated.index',
                            'route_edit': 'dashboard.fertilizers.edit',
                            'route_create': 'dashboard.fertilizers.create',
                            'route_delete': 'dashboard.fertilizers.delete'
                        }
                    %}
                {% endif %}
            </div>
            <!-- content-wrapper ends -->
            {% include 'components/dashboard/footer.html.twig' %}
        </div>
        <!-- main-panel ends -->
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" defer src="{{ asset('assets/js/dashboard/table/main.js') }}" data-entity="fertilizer"></script>
{% endblock %}
