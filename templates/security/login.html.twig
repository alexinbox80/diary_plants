{% extends 'layout/base.html.twig' %}

{% block title %}
    {{ 'page.login.title'|trans }}
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/dashboard/style.css') }}">
{% endblock %}

{% block favicon %}
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.png') }}" />
{% endblock %}

{% block javascripts %}
{% endblock %}

{% block content %}
    <div class="container-scroller">
        <div class="container-fluid page-body-wrapper full-page-wrapper">
            <div class="content-wrapper d-flex align-items-center auth">
                <div class="row flex-grow">
                    <div class="col-lg-4 mx-auto">
                        <div class="auth-form-light text-left p-5 shadow-sm bg-white rounded">

                            <div class="brand-logo text-center mb-4">
                                <h2 class="text-success font-weight-bold">DASHBOARD</h2>
                            </div>

                            <h4 class="font-weight-light mb-4">{{ 'page.login.header_form'|trans }}</h4>

                            <form method="post" class="pt-3">
                                {% if error %}
                                    <div class="alert alert-danger p-2 small">
                                        <i class="mdi mdi-alert-circle-outline"></i>
                                        {{ error.messageKey|trans(error.messageData, 'security') }}
                                    </div>
                                {% endif %}

                                {# Если пользователь уже залогинен #}
                                {% if app.user %}
                                    <div class="alert alert-info small">
                                        {{ 'page.login.enter_as'|trans }} <strong>{{ app.user.userIdentifier }}</strong>.
                                        <a href="{{ path('dashboard.logout') }}" class="alert-link text-decoration-none">{{ 'page.login.enter_as_exit_label'|trans }}</a>
                                    </div>
                                {% endif %}

                                <div class="form-group mb-3">
                                    <label for="inputEmail" class="small text-muted">{{ 'page.login.email'|trans }}</label>
                                    <input type="email"
                                           value="{{ last_username }}"
                                           name="_username"
                                           id="inputEmail"
                                           class="form-control form-control-lg border-success"
                                           placeholder="email@example.com"
                                           autocomplete="email"
                                           required
                                           autofocus>
                                </div>

                                <div class="form-group mb-4">
                                    <label for="inputPassword" class="small text-muted">{{ 'page.login.password'|trans }}</label>
                                    <input type="password"
                                           name="_password"
                                           id="inputPassword"
                                           class="form-control form-control-lg border-success"
                                           placeholder="********"
                                           autocomplete="current-password"
                                           required>
                                </div>

                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                                <div class="mt-3">
                                    <button class="btn btn-block btn-success btn-lg font-weight-medium auth-form-btn w-100" type="submit">
                                        {{ 'page.login.button_sign_in_label'|trans }}
                                    </button>
                                </div>

                                <div class="my-2 d-flex justify-content-between align-items-center">
                                    <div class="form-check">
                                        <label class="form-check-label text-muted">
                                            <input type="checkbox" name="_remember_me" class="form-check-input">
                                            {{ 'page.login.checkbox_remember_me_label'|trans }}
                                            <i class="input-helper-login"></i>
                                        </label>
                                    </div>
                                    <a href="#" class="auth-link text-black small">{{ 'page.login.forgot_password_label'|trans }}</a>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
