{% extends 'layout/base.html.twig' %}

{% block title %}
    Произошла ошибка
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/dashboard/style.css') }}">
{% endblock %}

{% block favicon %}
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.png') }}" />
{% endblock %}

{% block javascripts %}
{% endblock %}

{% block content %}
    <div class="container-scroller">
        {% block header %}{% endblock %}
        {% block body %}
            <div class="container-scroller">
                <div class="container-fluid page-body-wrapper full-page-wrapper">
                    <div class="content-wrapper d-flex align-items-center auth">
                        <div class="row flex-grow">
                            <div class="col-lg-4 mx-auto">
                                <div class="auth-form-light text-left p-5 shadow-sm bg-white rounded error-container">

                                    <div class="brand-logo text-center mb-4">
                                        <h1 class="text-success font-weight-bold">Упс! Ошибка {{ status_code|default('неизвестна') }}</h1>
                                    </div>

                                    <p class="font-weight-light mb-4">
                                        На сервере произошла непредвиденная ситуация.
                                        Мы уже получили уведомление об этом и занимаемся решением проблемы.
                                    </p>

                                    <div class="actions mt-4 d-flex justify-content-between align-items-center">
                                        <a href="/" class="auth-link text-dark small">
                                            <i class="bi bi-arrow-left"></i> Вернуться на главную
                                        </a>
                                        <a href="javascript:void(0)" onclick="location.reload()" class="auth-link text-dark small">
                                            Попробовать снова <i class="bi bi-arrow-clockwise"></i>
                                        </a>
                                    </div>

                                    {# В режиме отладки (dev) можно выводить детали, но в prod это должно быть скрыто логикой в обработчике #}
                                    {% if app.debug %}
                                        <div class="mt-4 p-3 bg-light border-start border-4 border-warning rounded text-start">
                                            <div class="fw-bold mb-1 text-dark">Developer Inspection:</div>
                                            <pre class="mb-0 small" style="white-space: pre-wrap;">
                                                <code>
                                                    Route:  {{ app.request.attributes.get('_route') }}
                                                    Code:   {{ status_code|default('500') }}
                                                    Error:  {{ exception.message|default(status_text|default('No message')) }}
                                                </code>
                                            </pre>
                                        </div>
                                    {% endif %}

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock %}
