<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            {% for child in form %}
                {% if child.vars.name not in ['color', 'emailConfirmed', 'phoneConfirmed', 'isActive', 'isShown', 'isSold', 'submit', '_token'] %}
                    <div class="form-group mb-3">
                        {{ form_label(child) }}
                        {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-error">
                            {{ form_errors(child) }}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
            {% if form.color is defined %}
                <div class="d-flex align-items-center mb-3">
                    {{ form_label(form.color) }}
                    {{ form_widget(form.color) }}
                    <div class="form-error">
                        {{ form_errors(form.color) }}
                    </div>
                </div>
            {% endif %}
            {% if form.isSold is defined %}
                <div class="form-check form-check-flat form-check-success">
                    <label class="form-check-label">
                        {{ form_widget(form.isSold, {'attr': {'class': 'form-check-input'}}) }}
                    </label>
                    {{ form_label(form.isSold, '', {'label_attr': {'class': 'form-check-text-label'}}) }}
                    <div class="form-error">
                        {{ form_errors(form.isSold) }}
                    </div>
                </div>
            {% endif %}
            {% if form.isShown is defined %}
                <div class="form-check form-check-flat form-check-success">
                    <label class="form-check-label">
                        {{ form_widget(form.isShown, {'attr': {'class': 'form-check-input'}}) }}
                    </label>
                    {{ form_label(form.isShown, '', {'label_attr': {'class': 'form-check-text-label'}}) }}
                    <div class="form-error">
                        {{ form_errors(form.isShown) }}
                    </div>
                </div>
            {% endif %}
            {% if form.isActive is defined %}
                <div class="form-check form-check-flat form-check-success">
                    <label class="form-check-label">
                        {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                    </label>
                    {{ form_label(form.isActive, '', {'label_attr': {'class': 'form-check-text-label'}}) }}
                    <div class="form-error">
                        {{ form_errors(form.isActive) }}
                    </div>
                </div>
            {% endif %}
            {% if form.emailConfirmed is defined %}
                <div class="form-check form-check-flat form-check-success">
                    <label class="form-check-label">
                        {{ form_widget(form.emailConfirmed, {'attr': {'class': 'form-check-input'}}) }}
                    </label>
                    {{ form_label(form.emailConfirmed, '', {'label_attr': {'class': 'form-check-text-label'}}) }}
                    <div class="form-error">
                        {{ form_errors(form.emailConfirmed) }}
                    </div>
                </div>
            {% endif %}
            {% if form.phoneConfirmed is defined %}
                <div class="form-check form-check-flat form-check-success">
                    <label class="form-check-label">
                        {{ form_widget(form.phoneConfirmed, {'attr': {'class': 'form-check-input'}}) }}
                    </label>
                    {{ form_label(form.phoneConfirmed, '', {'label_attr': {'class': 'form-check-text-label'}}) }}
                    <div class="form-error">
                        {{ form_errors(form.phoneConfirmed) }}
                    </div>
                </div>
            {% endif %}
            <button type="submit" class="btn btn-success me-2">Сохранить</button>
            <a class="btn btn-light" href="{{ path(route_cancel) }}">Отмена</a>
            {{ form_end(form) }}
        </div>
    </div>
</div>
