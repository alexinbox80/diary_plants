{% for type, messages in flashes %}
    {% for message in messages %}
        <div class="position-absolute top-50 start-50 translate-middle z-1">
            <div class="form-alert alert alert-{{ type }} alert-dismissible fade show d-flex flex-column" role="alert">
                <div class="alert-header">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <div class="alert-content d-flex justify-content-between">
                    <svg xmlns="http://www.w3.org/2000/svg" class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2" viewBox="0 0 16 16" role="img" aria-label="{{ type }}:">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                    <span class="me-auto">{{ message }}</span>
                </div>
            </div>
        </div>
    {% endfor %}
{% endfor %}

<script>
    // Ждем 3 секунды, затем скрываем alert
    setTimeout(function() {
        // Находим первый alert-элемент на странице
        const alertElement = document.querySelector('.form-alert');
        if (alertElement) {
            alertElement.classList.add('fade', 'show'); // Добавляем классы для анимации
            alertElement.classList.remove('show'); // Удаляем 'show' для начала анимации
            alertElement.addEventListener('transitionend', function() {
                alertElement.remove(); // Удаляем элемент из DOM после завершения анимации
            }, { once: true }); // Событие сработает один раз
        }
    }, 3000);
</script>
