<li class="nav-item dropdown d-none d-xl-inline-flex user-dropdown">
    <a class="nav-link dropdown-toggle" id="UserDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
        {% if app.user.avatarLink is not empty %}
            {% set src = 'uploads/' ~ app.user.getAvatarLink %}
        {% else %}
            {% set src = 'assets/images/dashboard/user/user_21980.png' %}
        {% endif %}
        <img class="img-xs rounded-circle ms-2" src="{{ asset(src) }}" alt="Profile image"> <span class="font-weight-normal"> {{ app.user.getShortName }} </span></a>
    <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="UserDropdown">
        <div class="dropdown-header text-center">
            <img class="img-md rounded-circle" src="{{ asset(src) }}" alt="Profile image">
            <p class="mb-1 mt-3">{{ app.user.getShortName }}</p>
            <p class="font-weight-light text-muted mb-0">{{ app.user.getUserIdentifier }}</p>
        </div>
        <a class="dropdown-item"><i class="dropdown-item-icon icon-user text-primary"></i>{{ 'dashboard.navbar.user_menu.profile'|trans }} <span class="badge badge-pill badge-danger">1</span></a>
        <a class="dropdown-item"><i class="dropdown-item-icon icon-speech text-primary"></i>{{ 'dashboard.navbar.user_menu.messages'|trans }}</a>
        <a class="dropdown-item"><i class="dropdown-item-icon icon-energy text-primary"></i>{{ 'dashboard.navbar.user_menu.activities'|trans }}</a>
        <a class="dropdown-item"><i class="dropdown-item-icon icon-question text-primary"></i>{{ 'dashboard.navbar.user_menu.faq'|trans }}</a>
        <a class="dropdown-item" href="{{ path('dashboard.logout') }}"><i class="dropdown-item-icon icon-power text-primary"></i>{{ 'dashboard.navbar.user_menu.logout'|trans }}</a>
    </div>
</li>
