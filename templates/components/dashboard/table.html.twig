{% import 'macros/dashboard/table_column.html.twig' as table_column %}
{% import 'macros/dashboard/image.html.twig' as image_tag %}
{% import 'macros/dashboard/images.html.twig' as gallery %}
{% import 'macros/dashboard/modal_delete.html.twig' as modal_del %}
{% import 'macros/dashboard/marker.html.twig' as icon_tag %}
{% import 'macros/dashboard/modal_qrlist.html.twig' as qrlist %}

<div class="row">
    <div class="col-md-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-sm-flex align-items-center mb-4">
                    <h4 class="card-title mb-sm-0">{% if title is defined %} {{ title }} {% endif %}</h4>
                    {{ table_column.show(array.table_header) }}
                    {% if pagination is defined and pagination.count < 101 %}
                        <a href="{{ path(route_index) }}" class="text-dark ms-auto mb-3 mb-sm-0 text-decoration-none">{{ 'dashboard.navbar.table.route_index_label'|trans }}</a>
                    {% else %}
                        <a href="{{ path(route_pagination) }}" class="text-dark ms-auto mb-3 mb-sm-0 text-decoration-none">{{ 'dashboard.navbar.table.route_pagination_label'|trans }}</a>
                    {% endif %}
                    <div class="ms-5 d-flex justify-content-end">
                        <div class="button">
                            {% if app.request.attributes.get('_route') starts with 'dashboard.plants' %}
                                <span id="" class="btn btn-light me-2" data-bs-toggle="modal" data-bs-target="#qrModal">{{ 'dashboard.navbar.table.qr_code_list_label'|trans }}</span>
                                {{ qrlist.modal_qrlist(array.table_body) }}
                            {% endif %}
                            {% if not(is_granted('ROLE_ADMIN')) %}
                                <a class="btn btn-success ms-auto" href="{{ path(route_create) }}">{{ 'dashboard.navbar.table.create_button_label'|trans }}</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% if array is defined %}
                    <div class="table-responsive border rounded pt-1">
                        <table class="table table-striped">
                            <thead>
                                {% for key, title in array.table_header %}
                                    <th class="font-weight-bold sortable" data-column="{{ key }}">
                                        {{ title|trans }}
                                        <span class="sort-arrow desc"></span>
                                    </th>
                                {% endfor %}
                                <th class="font-weight-bold">{{ 'dashboard.navbar.table.action_label'|trans }}</th>
                            </thead>
                            <tbody>
                                {% for row_number, item in array.table_body %}
                                    <tr>
                                        {% for column_number, key in array.table_header|keys %}
                                            {% if column_number > 0 %}
                                                <td data-column="{{ key }}" class="{% if key == 'img_tag' %}img_tag{% endif %}">
                                                    {% if item[key] is not null %}
                                                        {% if key == 'img_tag' %}
                                                            {{ image_tag.image(row_number, 'table-image-thumb', item['title'] ?? 'dashboard.navbar.table.avatar_label'|trans, item['alt'] ?? 'dashboard.navbar.table.avatar_label'|trans, item[key], 'single') }}
                                                        {% elseif key == 'icon_tag' %}
                                                            {{ icon_tag.marker(item.marker_color ?? item.color, item.marker_letter ?? item.letter) }}
                                                        {% elseif key == 'img_gallery' %}
                                                            {{ gallery.images(item.img_gallery, item.id) }}
                                                        {% elseif key == 'img_qr_code_link' %}
                                                            {{ image_tag.image(
                                                                row_number,
                                                                'table-image-qr',
                                                                item['title'] ??  'dashboard.navbar.table.qr_code_label'|trans,
                                                                item['alt'] ??  'dashboard.navbar.table.qr_code_label'|trans,
                                                                item[key] ~ '?t=' ~ 'now'|date('U'),
                                                                'single') }}
                                                        {% elseif key starts with 'is_' or key ends with '_confirmed' %}
                                                            {{ item[key] ? 'twig.label.yes'|trans : 'twig.label.no'|trans }}
                                                        {% elseif key == 'type' or key == 'pot_material' or key == 'roles' or key == 'time_zone' %}
                                                            {{ item[key]|trans }}
                                                        {% else %}
                                                            {{ item[key] }}
                                                        {% endif %}
                                                    {% endif %}
                                                </td>
                                            {% else %}
                                                <td title="{{ item[key] }}" data-column="{{ key }}">
                                                    {{ row_number + 1 }}
                                                </td>
                                            {% endif %}
                                        {% endfor %}
                                        <td>
                                            <div class="dropdown dropdown-menu-edit-remove-div">
                                                <div
                                                    class="dropdown-toggle border-0"
                                                    type="button"
                                                    id="dropdownMenuButton{{ loop.index }}"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                >
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </div>
                                                <div
                                                    class="dropdown-menu dropdown-menu-end dropdown-menu-edit-remove"
                                                    aria-labelledby="dropdownMenuButton{{ loop.index }}"
                                                >
                                                    <div class="d-flex">
                                                        {% if not(is_granted('ROLE_ADMIN')) %}
                                                            <a
                                                                href="{{ path(route_edit, {'id': item.id}) }}"
                                                                class="dropdown-item px-3"
                                                                title="{{ 'dashboard.navbar.table.action_edit_label'|trans  }}"
                                                            >
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                        {% endif %}
                                                        <a
                                                            href="#"
                                                            class="dropdown-item px-3 text-danger"
                                                            title="{{ 'dashboard.navbar.table.action_delete_label'|trans  }}"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#confirmDeleteModal"
                                                            data-id="{{ item.id }}"
                                                            data-title="{{ item.title|default('Удалить запись') }}"
                                                            data-token="{{ csrf_token('delete' ~ item.id) }}"
                                                        >
                                                            <i class="fas fa-trash text-danger"></i>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% if pagination is defined %}
                        {% include 'components/dashboard/pagination.html.twig' with { 'pagination': pagination, 'page_url': route_pagination } %}
                    {% endif %}
                {% else %}
                    <div class="d-flex mt-4 flex-wrap align-items-center">
                        <p class="text-muted mb-sm-0">{{ 'dashboard.navbar.table.no_data_label'|trans  }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{{ modal_del.delete(route_delete) }}
