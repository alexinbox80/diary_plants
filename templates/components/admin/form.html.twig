<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_errors(form) }}
            {% for child in form %}
                {% if child.vars.name not in ['isShown', 'submit'] %}
                    <div class="form-group mb-3">
                        {{ form_label(child) }}
                        {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
                        <div class="form-error">
                            {{ form_errors(child) }}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
            <div class="form-check form-check-flat form-check-primary">
                <label class="form-check-label">
                    {{ form_widget(form.isShown, {'attr': {'class': 'form-check-input'}}) }}
                    Показывать растение
                </label>
                <div class="form-error">
                    {{ form_errors(form.isShown) }}
                </div>
            </div>
            <button type="submit" class="btn btn-primary me-2">Сохранить</button>
{#            {{ form_row(form.submit) }}#}
            <a class="btn btn-light" href="{{ path(route_cancel) }}">Отмена</a>
            {{ form_end(form) }}
        </div>
    </div>
</div>
